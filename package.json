{
  "name": "purrlane",
  "private": true,
  "version": "1.0.0",
  "description": "Purrlane \u2014 a cozy, interactive WebGL cat playground built with TypeScript and Three.js.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --host",
    "typecheck": "tsc --noEmit",
    "smoke": "esbuild tools/smoke.ts --bundle --platform=node --format=esm --target=es2022 --outfile=node_modules/.cache/purrlane-smoke.mjs --log-level=warning && node node_modules/.cache/purrlane-smoke.mjs",
    "smoke:hud": "esbuild tools/hud-check.ts --bundle --platform=node --format=esm --target=es2022 --external:jsdom --outfile=node_modules/.cache/purrlane-hud.mjs --log-level=warning && node node_modules/.cache/purrlane-hud.mjs",
    "check": "npm run typecheck && npm run smoke && npm run smoke:hud"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "esbuild": "^0.25.0",
    "jsdom": "^26.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.7"
  },
  "engines": {
    "node": ">=20.19"
  }
}
